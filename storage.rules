rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/profile/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && (request.resource == null
          || (request.resource.size < 5 * 1024 * 1024
            && request.resource.contentType.matches('image/.*')));
    }

    match /users/{userId}/media/{mediaType}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && (request.resource == null
          || (request.resource.size < 50 * 1024 * 1024
            && request.resource.contentType.matches('(image|video|audio)/.*')));
    }

    match /users/{userId}/secret_media/{mediaType}/{fileName} {
      allow read: if request.auth != null
        && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && (request.resource == null
          || (request.resource.size < 50 * 1024 * 1024
            && request.resource.contentType.matches('(image|video|audio)/.*')));
    }

    match /rooms/{roomId}/secret_media/{userId}/{mediaType}/{fileName} {
      function isRoomMember() {
        return request.auth != null
          && firestore.exists(
            /databases/(default)/documents/rooms/$(roomId)/members/$(request.auth.uid)
          );
      }

      allow read: if isRoomMember();
      allow write: if isRoomMember()
        && request.auth.uid == userId
        && (request.resource == null
          || (request.resource.size < 50 * 1024 * 1024
            && request.resource.contentType.matches('(image|video|audio)/.*')));
    }
  }
}
