rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn()
        && get(/databases/$(database)/documents/config/app).data.ownerUid == request.auth.uid;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isMember(roomId, memberId) {
      return exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(memberId));
    }

    function isRoomMember(roomId) {
      return signedIn() && isMember(roomId, request.auth.uid);
    }

    function isSecretChat(chatId) {
      return chatId == 'secret_group'
        || chatId.matches('^secret_group_.+$')
        || chatId == 'shadow_ops';
    }

    function secretRoomId(chatId) {
      return chatId == 'shadow_ops' ? 'secret_room' : 'secret_group';
    }

    function isPrivateSecretGroup(roomId) {
      return roomId.matches('^secret_group_.+$');
    }

    function isPrivateSecretGroupOwner(roomId) {
      return signedIn()
        && get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerUid == request.auth.uid;
    }
    function secretRoomCapacityPath() {
      return /databases/$(database)/documents/rooms/secret_room/metadata/capacity;
    }
    function secretRoomMemberPath(memberId) {
      return /databases/$(database)/documents/rooms/secret_room/members/$(memberId);
    }

    function canAccessSecretChat(chatId) {
      return (isPrivateSecretGroup(chatId) && isRoomMember(chatId))
        || (chatId == 'shadow_ops'
          && (isOwner() || isRoomMember(secretRoomId(chatId))));
    }

    function hasAcceptedContact(otherUserId) {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)/regularContacts/$(otherUserId)).data.status == 'accepted';
    }

    function isApprovedDirectChat(chatId) {
      let chat = get(/databases/$(database)/documents/chats/$(chatId)).data;
      return signedIn()
        && chat.chatType == 'direct'
        && chat.participantA is string
        && chat.participantB is string
        && (chat.participantA == request.auth.uid || chat.participantB == request.auth.uid)
        && hasAcceptedContact(
          chat.participantA == request.auth.uid
            ? chat.participantB
            : chat.participantA
        );
    }

    function isDirectChatParticipant(chatId) {
      let chat = get(/databases/$(database)/documents/chats/$(chatId)).data;
      return signedIn()
        && chat.chatType == 'direct'
        && (chat.participantA == request.auth.uid
          || chat.participantB == request.auth.uid);
    }

    function canAccessChat(chatId) {
      return canAccessSecretChat(chatId)
        || (signedIn() && !isSecretChat(chatId)
          && (get(/databases/$(database)/documents/chats/$(chatId)).data.chatType != 'direct'
            || isApprovedDirectChat(chatId)));
    }

    match /chats/{chatId}/messages/{messageId} {
      allow read: if canAccessChat(chatId);
      allow create: if signedIn()
        && canAccessChat(chatId)
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 4000
        && request.resource.data.uid == request.auth.uid;
      allow update: if canAccessChat(chatId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['deletedFor'])
        && request.resource.data.get('deletedFor', []) is list
        && resource.data.get('deletedFor', []) is list
        && request.resource.data.get('deletedFor', [])
          .hasAll(resource.data.get('deletedFor', []))
        && request.resource.data.get('deletedFor', []).hasAll([request.auth.uid])
        && request.resource.data.get('deletedFor', []).size()
          <= resource.data.get('deletedFor', []).size() + 1;
      allow delete: if canAccessChat(chatId)
        && resource.data.uid == request.auth.uid;
    }

    match /chats/{chatId} {
      allow read: if canAccessChat(chatId);
      allow create: if signedIn()
        && (
          request.resource.data.chatType != 'direct'
          || (
            request.resource.data.participantA is string
            && request.resource.data.participantB is string
            && request.resource.data.participantA != request.resource.data.participantB
            && (request.resource.data.participantA == request.auth.uid
              || request.resource.data.participantB == request.auth.uid)
            && hasAcceptedContact(
              request.resource.data.participantA == request.auth.uid
                ? request.resource.data.participantB
                : request.resource.data.participantA
            )
          )
        );
      allow update: if canAccessChat(chatId);
      allow delete: if isDirectChatParticipant(chatId);
    }

    match /users/{userId}/groupContacts/{contactId} {
      allow read, write: if isSelf(userId);
    }

    match /users/{userId}/secretGroups/{groupId} {
      allow read: if isSelf(userId);
      allow create, update: if isSelf(userId)
        || (isPrivateSecretGroup(groupId)
          && isRoomMember(groupId)
          && isMember(groupId, userId)
          && request.resource.data.roomId == groupId);
      allow delete: if isSelf(userId)
        || isPrivateSecretGroupOwner(groupId);
    }

    match /users/{userId}/roomContacts/{contactId} {
      allow read, write: if isSelf(userId);
    }

    match /users/{userId}/regularContacts/{contactId} {
      allow read: if isSelf(userId)
        || (signedIn() && contactId == request.auth.uid);
      allow create: if (isSelf(userId)
          && contactId != request.auth.uid
          && request.resource.data.uid == contactId
          && request.resource.data.status == 'pending')
        || (signedIn()
          && contactId == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status == 'incoming');
      allow update: if (isSelf(userId)
          && ((resource.data.status == 'incoming'
                && request.resource.data.status in ['accepted', 'rejected'])
              || (resource.data.status == 'pending'
                && resource.data.uid == request.auth.uid
                && request.resource.data.status == 'rejected')
              || (resource.data.status == 'rejected'
                && resource.data.uid == contactId
                && request.resource.data.status == 'pending')))
        || (signedIn()
          && resource.data.uid == request.auth.uid
          && ((resource.data.status == 'pending'
                && request.resource.data.status in ['accepted', 'rejected'])
              || (resource.data.status == 'rejected'
                && request.resource.data.status == 'incoming')));
      allow delete: if isSelf(userId)
        || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /users/{userId}/security/appLock {
      allow read: if isSelf(userId);
      allow create, update: if isSelf(userId)
        && request.resource.data.passwordHash is string
        && request.resource.data.enabled is bool;
      allow delete: if false;
    }

    match /users/{userId}/chatSecurity/{chatId} {
      allow read, write: if isSelf(userId);
    }

    match /users/{userId}/settings/{settingId} {
      allow read, write: if isSelf(userId);
    }

    match /users/{userId} {
      allow read: if isSelf(userId);
      allow create, update: if isSelf(userId);
      allow delete: if false;
    }

    match /publicProfiles/{userId} {
      allow read: if signedIn();
      allow create, update: if isSelf(userId);
      allow delete: if false;
    }

    match /rooms/{roomId} {
      allow read: if isPrivateSecretGroup(roomId)
        && (isRoomMember(roomId)
          || (signedIn() && resource.data.ownerUid == request.auth.uid));
      allow create: if isPrivateSecretGroup(roomId)
        && signedIn()
        && roomId == 'secret_group_' + request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isPrivateSecretGroup(roomId)
        && signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if false;
    }

    match /rooms/{roomId}/members/{memberId} {
      allow read: if (isPrivateSecretGroup(roomId)
          && (isRoomMember(roomId) || isPrivateSecretGroupOwner(roomId)))
        || (roomId == 'secret_room' && (isRoomMember(roomId) || isOwner()));
      allow create: if (isPrivateSecretGroup(roomId)
          && (isPrivateSecretGroupOwner(roomId) || isRoomMember(roomId))
          && request.resource.data.addedBy == request.auth.uid)
        || (roomId == 'secret_room'
          && isOwner()
          && request.resource.data.addedBy == request.auth.uid
          && get(secretRoomCapacityPath()).data.memberCount is int
          && get(secretRoomCapacityPath()).data.memberCount < 100
          && getAfter(secretRoomCapacityPath()).data.memberCount
            == get(secretRoomCapacityPath()).data.memberCount + 1
          && getAfter(secretRoomCapacityPath()).data.lastMemberId == memberId);
      allow update: if (isPrivateSecretGroup(roomId)
          && isRoomMember(roomId)
          && request.resource.data.addedBy == resource.data.addedBy)
        || (roomId == 'secret_room'
          && isOwner()
          && request.resource.data.addedBy == resource.data.addedBy);
      allow delete: if (isPrivateSecretGroup(roomId)
          && (isPrivateSecretGroupOwner(roomId)
            || (signedIn() && request.auth.uid == memberId)))
        || (roomId == 'secret_room'
          && (isOwner() || (signedIn() && request.auth.uid == memberId))
          && (!exists(secretRoomCapacityPath())
            || (get(secretRoomCapacityPath()).data.memberCount is int
              && get(secretRoomCapacityPath()).data.memberCount > 0
              && getAfter(secretRoomCapacityPath()).data.memberCount
                == get(secretRoomCapacityPath()).data.memberCount - 1
              && getAfter(secretRoomCapacityPath()).data.lastMemberId == memberId)))
        || (roomId == 'secret_group'
          && signedIn()
          && request.auth.uid == memberId);
    }

    match /rooms/secret_room/metadata/capacity {
      allow read: if isOwner() || isRoomMember('secret_room');
      allow create: if isOwner()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberCount is int
        && request.resource.data.memberCount >= 1
        && request.resource.data.memberCount <= 100;
      allow update: if request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['memberCount', 'lastMemberId', 'updatedAt'])
        && request.resource.data.memberCount is int
        && (
          (isOwner()
            && request.resource.data.memberCount == resource.data.memberCount + 1
            && request.resource.data.memberCount <= 100
            && request.resource.data.lastMemberId is string
            && getAfter(secretRoomMemberPath(
              request.resource.data.lastMemberId
            )).data.addedBy == request.auth.uid)
          || ((isOwner()
                || (signedIn()
                  && request.auth.uid == request.resource.data.lastMemberId))
              && request.resource.data.memberCount == resource.data.memberCount - 1
              && request.resource.data.memberCount >= 0
              && request.resource.data.lastMemberId is string
              && exists(secretRoomMemberPath(
                request.resource.data.lastMemberId
              ))
              && !existsAfter(secretRoomMemberPath(
                request.resource.data.lastMemberId
              )))
        );
      allow delete: if false;
    }

    match /config/app {
      allow read: if signedIn();
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/config/app)
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isOwner()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.ownerKeyHash is string
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['ownerKeyHash', 'updatedAt']);
      allow delete: if false;
    }

    match /config/secretRoom {
      allow read: if signedIn();
      allow create, update: if isOwner()
        && request.resource.data.codeHash is string;
      allow delete: if false;
    }
  }
}
